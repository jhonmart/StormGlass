{
  "name": "serverexpress",
  "version": "1.0.0",
  "description": "Express with typescript Node.js API",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "lint:check": "eslint",
    "lint:fix": "yarn lint --fix",
    "start": "yarn build && node dist/src/index.js",
    "start:dev": "ts-node-dev 'src/index.ts'",
    "test:functional": "jest --projects ./test --runInBand",
    "test:unit": "jest",
    "style:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "style:fix": "prettier --write 'src/**/*.ts' 'test/**/*.ts'"
  },
  "keywords": [
    "node",
    "nodejs",
    "express",
    "typescript",
    "js"
  ],
  "author": "jhonmart",
  "license": "ISC",
  "devDependencies": {
    "@types/axios": "^0.14.4",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@overnightjs/core": "^1.7.6",
    "axios": "^1.7.9",
    "body-parser": "^1.20.3",
    "express": "^4.21.2",
    "module-alias": "^2.2.3"
  }
}
